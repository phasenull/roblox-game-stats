{
  "manifest_version": 3,
  "name": "Roblox Game Stats",
  "version": "2.0.0",
  "description": "Shows CreatorExchange, RoTerminal and RoTrends stats for the Roblox game in the current tab.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://apis.roblox.com/*",
    "https://games.roblox.com/*",
    "https://creatorexchange.io/*",
    "https://roterminal.co/*",
    "https://www.rotrends.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Roblox Game Stats", "default_popup": "popup.html" }
}
